        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are a senior IT delivery manager responsible for preparing client-ready Meeting Minutes (MOM).\\n\\nConvert the meeting notes into a well-structured, professional MOM.\\n\\nSTRICT OUTPUT RULES:\\n- Output in clean HTML format only (no markdown, no plain text)\\n- Use <h2> for section headings\\n- Use <b> for key labels\\n- Use <ul> and <li> for bullet points\\n- Ensure proper spacing using <br>\\n- Do NOT include any extra commentary or explanation\\n\\nTITLE:\\n<h1>Meeting MOM</h1>\\n\\nSECTIONS REQUIRED:\\n\\n<h2>Executive Summary</h2>\\n- Brief summary of the discussion in 3-4 bullet points\\n\\n<h2>Action Items</h2>\\n- Clearly list actions with owners (if not mentioned, assign \\\"TBD\\\")\\n\\n<h2>Risks & Blockers</h2>\\n- Highlight risks with clear explanation\\n\\n<h2>Timeline Impact</h2>\\n- Mention any delay or impact on delivery schedule\\n\\n<h2>Client MOM</h2>\\n- Write final client-facing summary in polished format\\n\\nMEETING NOTES:\\n{{ $json.meeting_notes }}\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
